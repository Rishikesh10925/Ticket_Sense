# Copy this file to .env for local development.
# Used by docker-compose.yml (Postgres container) and backend/app/config.py.

# --- Postgres (pgvector) ---
POSTGRES_USER=ticketsense
POSTGRES_PASSWORD=ticketsense
POSTGRES_DB=ticketsense
POSTGRES_PORT=5432

# --- App ---
APP_ENV=development
CORS_ORIGINS=http://localhost:5173

# Full SQLAlchemy async URL — must stay in sync with the POSTGRES_* values above.
# Used when running the backend/Alembic outside Docker (localhost); inside Docker
# Compose the api service builds this itself pointing at the db service instead.
DATABASE_URL=postgresql+asyncpg://ticketsense:ticketsense@localhost:5432/ticketsense

# --- Auth ---
# Generate your own for real use: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=changeme-generate-a-real-secret-per-above
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
