{
  "manifest_version": 3,
  "name": "TicketSense Assistant",
  "short_name": "TicketSense",
  "version": "0.1.0",
  "description": "Ask TicketSense from any page: a cited answer from the knowledge base, or the right complaint portal filled in for you to submit.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open TicketSense",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["sidePanel", "storage", "scripting", "contextMenus"],
  "host_permissions": ["http://localhost:8000/*", "http://127.0.0.1:8000/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}
